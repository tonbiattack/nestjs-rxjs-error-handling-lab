{
  "name": "nestjs-rxjs-error-handling-lab",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS HttpService and RxJS error propagation debugging lab",
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "axios": "^1.8.0",
    "rxjs": "^7.8.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testRegex": "(/test/.*\\.(spec|e2e-spec)\\.ts)$",
    "transform": {"^.+\\.ts$": "ts-jest"},
    "testEnvironment": "node",
    "moduleDirectories": ["node_modules", "src"]
  }
}
